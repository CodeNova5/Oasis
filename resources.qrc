<RCC>
    <qresource prefix="/">
        <file>icons/app.ico</file>
        <file>icons/Oasis.png</file>
    </qresource>
    <qresource prefix="/theme">
        <file alias="styles/base.qss">src/ui/theme/styles/base.qss</file>
        <file alias="styles/controls.qss">src/ui/theme/styles/controls.qss</file>
        <file alias="styles/data.qss">src/ui/theme/styles/data.qss</file>
        <file alias="styles/overlays.qss">src/ui/theme/styles/overlays.qss</file>
    </qresource>
    <qresource prefix="/fonts">
        <file alias="Inter-Regular.ttf">resources/fonts/Inter-Regular.ttf</file>
        <file alias="Inter-Medium.ttf">resources/fonts/Inter-Medium.ttf</file>
        <file alias="Inter-SemiBold.ttf">resources/fonts/Inter-SemiBold.ttf</file>
        <file alias="Inter-Bold.ttf">resources/fonts/Inter-Bold.ttf</file>
        <file alias="JetBrainsMono-Regular.ttf">resources/fonts/JetBrainsMono-Regular.ttf</file>
        <file alias="JetBrainsMono-Medium.ttf">resources/fonts/JetBrainsMono-Medium.ttf</file>
    </qresource>
    <qresource prefix="/web/ui">
        <file alias="index.html">web/ui/dist/index.html</file>
        <file alias="app.js">web/ui/dist/app.js</file>
        <file alias="app.css">web/ui/dist/app.css</file>
    </qresource>
</RCC>
